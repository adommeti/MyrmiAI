# ---- Claude ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- YouTube (OAuth, read-only subscriptions) ----
# Produced once by: python scripts/auth_youtube.py
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
GOOGLE_REFRESH_TOKEN=...

# ---- Delivery (optional; digest is always written to digests/) ----
# SMTP: Gmail needs an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
DIGEST_TO=you@gmail.com

# ---- Transcripts (optional but strongly recommended for CI) ----
# YouTube blocks datacenter IPs for caption fetches. Without a residential
# proxy, runs from GitHub Actions fall back to title+description summaries.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
